{
  "name": "vitrine",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-free web components to display code, Markdown and JSON on any website.",
  "license": "MIT",
  "author": "ecrou-exact",
  "homepage": "https://github.com/ecrou-exact/vitrine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecrou-exact/vitrine.git"
  },
  "bugs": {
    "url": "https://github.com/ecrou-exact/vitrine/issues"
  },
  "type": "module",
  "main": "./dist/vitrine.esm.js",
  "module": "./dist/vitrine.esm.js",
  "exports": {
    ".": "./dist/vitrine.esm.js",
    "./custom-elements.json": "./dist/custom-elements.json"
  },
  "customElements": "dist/custom-elements.json",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.js && npm run manifest",
    "manifest": "cem analyze --config custom-elements-manifest.config.js",
    "dev": "node scripts/build.js --watch",
    "serve": "node scripts/serve.js . 4173",
    "languages": "node scripts/generate-language-index.js",
    "tokens": "node scripts/generate-tokens.js",
    "size": "node scripts/size.js",
    "site": "npm run build && node scripts/build-site.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && node scripts/generate-tokens.js --check && node scripts/generate-notices.js --check",
    "notices": "node scripts/generate-notices.js",
    "syntax-themes": "node scripts/generate-syntax-index.js"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "syntax-highlighting",
    "code-viewer",
    "markdown",
    "json-viewer",
    "no-framework"
  ],
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@eslint/js": "10.0.1",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "happy-dom": "20.14.5",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "marked": "18.1.0"
  }
}
